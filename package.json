{
  "name": "qcs",
  "version": "1.2.0",
  "private": true,
  "bin": {
    "qcs": "src/cli/main.ts"
  },
  "type": "module",
  "scripts": {
    "start": "bun run src/cli/main.ts",
    "dev": "bun run scripts/dev.ts",
    "dev:reset": "bun run scripts/dev.ts reset",
    "test": "bun test --parallel",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@opentui/core": "0.7.0",
    "@opentui/react": "0.7.0",
    "react": "19.3.1",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@santux/oxc-config": "1.0.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint-plugin-check-file": "3.3.2",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
